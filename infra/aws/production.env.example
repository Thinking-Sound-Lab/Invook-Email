# Copy to .env.production.local. This file contains only API/worker variables.
# configure sends ordinary settings to ECS and credentials to Secrets Manager.
# Ordinary settings
# APP_URL is the stable production *.vercel.app URL, not a per-build URL.
APP_URL=

# Temporal Cloud production namespace. The AWS stack sets a unique task queue prefix.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
BETTER_AUTH_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_PUBSUB_TOPIC=
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=

# Sensitive values: kept together in <AWS_STACK_NAME>/runtime.
# Supabase PostgreSQL: use the IPv4 session pooler on port 5432 with sslmode=verify-full.
# Transaction pooling on port 6543 cannot preserve LISTEN or advisory locks.
DATABASE_URL=
TEMPORAL_API_KEY=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
GMAIL_GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=

# S3 endpoint, bucket, region and ECS task credentials come from CloudFormation.
# API_INTERNAL_URL belongs in Vercel, using the stack's ApiUrl output.
