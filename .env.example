# Application
APP_URL=http://localhost:3000

# Application database. Use any PostgreSQL provider; `make dev` uses local PostgreSQL.
DATABASE_URL=postgresql://invook:invook@127.0.0.1:54322/invook

# Google OAuth and Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Mail classification, feedback learning, and drafting.
# Point this at any OpenAI-compatible model endpoint.
# AI_API_KEY can stay empty for a local endpoint such as Ollama.
# When the app runs in Docker, use host.docker.internal instead of 127.0.0.1.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=

# Initial Memory analysis uses Gemini's native Batch API.
# Create the signed callback after exposing /v1/webhooks/gemini over HTTPS.
GEMINI_API_KEY=
GEMINI_WEBHOOK_SECRET=
