# Application
APP_URL=http://localhost:3000

# Application database. Use any PostgreSQL provider; `make dev` uses local PostgreSQL.
DATABASE_URL=postgresql://invook:invook@127.0.0.1:54322/invook

# BullMQ queue storage. Docker services use redis://redis:6379 internally.
REDIS_URL=redis://127.0.0.1:63790

# Google OAuth and Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Mail classification, feedback learning, and drafting.
# Point this at any OpenAI-compatible model endpoint.
# AI_API_KEY can stay empty for a local endpoint such as Ollama.
# When the app runs in Docker, use host.docker.internal instead of 127.0.0.1.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=

# Initial Memory analysis uses one native Batch provider: openai or azure-openai.
MEMORY_BATCH_PROVIDER=

# OpenAI Batch
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
# Mail search embeddings use the same OpenAI key and webhook.
# Set the model and dimensions explicitly so historical Batch and incoming-mail
# embeddings always share one vector shape.
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=

# Azure OpenAI Batch. Use a Global-Batch or Data Zone Batch deployment.
AZURE_OPENAI_API_KEY=
# Resource root or the same URL ending in /openai/v1.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_BATCH_DEPLOYMENT=
# Set this to the documented maximum input tokens for the deployed model.
AZURE_OPENAI_BATCH_INPUT_TOKEN_LIMIT=
AZURE_OPENAI_WEBHOOK_SECRET=
